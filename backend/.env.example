# ─────────────────────────────────────────────
# OpenPoll Backend 환경변수 예시
# 실제 값을 채운 뒤 이 파일을 `.env` 로 복사해서 사용하세요. (`.env` 는 커밋 금지)
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/openpoll?schema=public"

# Redis (rediss:// 로 시작하면 TLS 자동 적용)
REDIS_URL="redis://localhost:6379"

# JWT (secret 은 openssl rand -hex 32 등으로 충분히 긴 랜덤값 사용)
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (허용할 프론트엔드 origin)
CORS_ORIGIN="http://localhost:5173"

# 관리자 계정 (seed 시 생성됨. 비어있으면 admin seed 스킵)
ADMIN_PASSWORD=

# OpenAI API Key (뉴스 AI 요약)
OPENAI_API_KEY=

# SMTP (이메일 인증 코드 발송)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 뉴스 갱신 설정 (운영 인터벌 권장: 600000ms = 10분)
NEWS_INTERVAL_MS=600000
COOLDOWN_SEC=590

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/google/callback"
GOOGLE_CLIENT_SECRET=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_REDIRECT_URI="http://localhost:3000/api/auth/oauth/naver/callback"
NAVER_CLIENT_SECRET=
